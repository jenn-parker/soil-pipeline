# Copy this file to .env and replace values marked as CHANGE_ME.
# Never commit the resulting .env file.

# Required by LocalStack Community/Pro when running Docker Compose.
LOCALSTACK_AUTH_TOKEN=CHANGE_ME_LOCALSTACK_AUTH_TOKEN

# Use api_key for a simple local demo or cognito for the OAuth flow.
AUTH_PROVIDER=api_key
AUTH_API_KEYS=CHANGE_ME_LOCAL_KEY=soil:read,soil:write,batch:upload
AUTH_COOKIE_SECURE=false
AUTH_SESSION_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE

# Cognito values are required only when AUTH_PROVIDER=cognito.
COGNITO_ISSUER=
COGNITO_APP_CLIENT_ID=
COGNITO_LOGIN_DOMAIN=
COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
COGNITO_LOGOUT_URI=http://localhost:5173/
COGNITO_SCOPES=openid email https://soil-pipeline.local/soil:read https://soil-pipeline.local/soil:write https://soil-pipeline.local/batch:upload

# These values are used when running the API outside Docker Compose.
DATABASE_URL=postgresql+asyncpg://earth_user:earth_password@localhost:5432/soil_db
AWS_ENDPOINT_URL_S3=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BATCH_BUCKET=soil-pipeline-batches

# Optional AI explanations. Leave blank to keep recommendations local-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Local diagnostics.
LOG_LEVEL=INFO
SQL_ECHO=false
